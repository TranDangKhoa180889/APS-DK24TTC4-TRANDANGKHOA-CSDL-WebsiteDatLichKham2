@model WebDatLichKham.Models.Appointment

@{
    ViewData["Title"] = "Xóa lịch hẹn";
}

<h2>Xóa lịch hẹn</h2>

<h4>Bạn có chắc muốn xóa lịch hẹn này không?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-2">Bệnh nhân</dt>
    <dd class="col-sm-10">@Model.PatientName</dd>

    <dt class="col-sm-2">Bác sĩ</dt>
    <dd class="col-sm-10">@Model.Doctor?.DoctorName</dd>

    <dt class="col-sm-2">Ngày khám</dt>
    <dd class="col-sm-10">
        @Model.AppointmentDate.ToString("dd/MM/yyyy")
    </dd>

    <dt class="col-sm-2">Giờ khám</dt>
    <dd class="col-sm-10">@Model.AppointmentTime</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>