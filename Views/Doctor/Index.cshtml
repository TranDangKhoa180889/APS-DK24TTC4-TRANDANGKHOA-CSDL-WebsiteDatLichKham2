@model IEnumerable<WebDatLichKham.Models.DoctorModel>?

@{
    ViewData["Title"] = "Danh sách bác sĩ";
}

<h2>Danh sách bác sĩ</h2>

<p>
    <a asp-action="Add" class="btn btn-primary">Thêm bác sĩ</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên bác sĩ</th>
            <th>Chuyên khoa</th>
            <th>Số điện thoại</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model ?? Enumerable.Empty<WebDatLichKham.Models.DoctorModel>())
        {
            <tr>
                <td>@item.DoctorName</td>
                <td>@item.Specialty</td>
                <td>@item.Phone</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>