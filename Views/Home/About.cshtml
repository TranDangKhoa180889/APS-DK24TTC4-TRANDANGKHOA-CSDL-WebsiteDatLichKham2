@{
    ViewData["Title"] = "Giới thiệu";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #4e73df, #1cc88a);
        color: white;
        padding: 80px 20px;
        border-radius: 15px;
    }

    .feature-card {
        transition: 0.3s;
        border-radius: 15px;
    }

    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.2);
    }

    .about-section {
        padding: 60px 0;
    }

    .icon-big {
        font-size: 40px;
    }
</style>

<div class="container mt-5">

    <!-- HERO -->
    <div class="hero-section text-center shadow">
        <h1 class="fw-bold mb-3">HỆ THỐNG ĐẶT LỊCH KHÁM BỆNH</h1>
        <p class="lead">
            Nền tảng hỗ trợ bệnh nhân đặt lịch khám nhanh chóng, tiện lợi và hiện đại.
        </p>
    </div>

    <!-- GIỚI THIỆU -->
    <div class="about-section">
        <div class="row align-items-center">
            <div class="col-md-6">
                <img src="https://cdn-icons-png.flaticon.com/512/4320/4320371.png"
                     class="img-fluid rounded shadow"
                     alt="Hospital">
            </div>

            <div class="col-md-6">
                <h2 class="fw-bold text-primary">Mục tiêu của hệ thống</h2>
                <p>
                    Website được xây dựng nhằm giúp bệnh nhân dễ dàng đặt lịch khám
                    với bác sĩ mà không cần chờ đợi lâu tại bệnh viện.
                </p>

                <ul>
                    <li>✔ Quản lý bác sĩ và lịch khám</li>
                    <li>✔ Đặt lịch nhanh chóng</li>
                    <li>✔ Giao diện thân thiện, dễ sử dụng</li>
                    <li>✔ Lưu trữ dữ liệu an toàn</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- TÍNH NĂNG -->
    <div class="about-section text-center">
        <h2 class="fw-bold mb-5 text-success">Tính năng nổi bật</h2>

        <div class="row">

            <div class="col-md-4 mb-4">
                <div class="card feature-card p-4 shadow">
                    <div class="icon-big text-primary mb-3">👨‍⚕️</div>
                    <h4>Quản lý bác sĩ</h4>
                    <p>Thêm, sửa, xóa thông tin bác sĩ và chuyên khoa.</p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card feature-card p-4 shadow">
                    <div class="icon-big text-success mb-3">📅</div>
                    <h4>Đặt lịch khám</h4>
                    <p>Đặt lịch hẹn nhanh chóng chỉ với vài thao tác đơn giản.</p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card feature-card p-4 shadow">
                    <div class="icon-big text-danger mb-3">🔒</div>
                    <h4>Bảo mật thông tin</h4>
                    <p>Thông tin bệnh nhân được bảo mật an toàn.</p>
                </div>
            </div>

        </div>
    </div>

    <!-- THÔNG TIN SINH VIÊN -->
    <div class="text-center mt-5">
        <hr />
        <h4 class="fw-bold">Sinh viên thực hiện</h4>
        <p class="mb-1">👨‍🎓 Trần Đăng Khoa</p>
        <p class="text-muted">Dự án môn học - Năm 2026</p>
    </div>

</div>