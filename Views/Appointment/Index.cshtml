@model IEnumerable<WebDatLichKham.Models.Appointment>

@{
    ViewData["Title"] = "Danh sách lịch hẹn";
}

<h2>Danh sách lịch hẹn</h2>

<p>
    <a asp-action="Add" class="btn btn-primary">Thêm mới</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Bệnh nhân</th>
            <th>Bác sĩ</th>
            <th>Ngày khám</th>
            <th>Giờ khám</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@(item?.PatientName ?? "")</td>
                    <td>@(item?.Doctor?.Name ?? "")</td>
                    <td>@(item?.AppointmentDate.ToString("dd/MM/yyyy") ?? "")</td>
                    <td>@(item?.AppointmentTime ?? "")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item?.Id" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item?.Id" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">Không có dữ liệu</td>
            </tr>
        }
    </tbody>
</table>