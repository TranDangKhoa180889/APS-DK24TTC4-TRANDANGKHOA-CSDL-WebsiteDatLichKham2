@model IEnumerable<WebDatLichKham.Models.Appointment>

@{
    ViewData["Title"] = "Danh sách lịch khám";
}

<h2>Danh sách lịch khám</h2>

<p>
    <a asp-action="Add" class="btn btn-primary">Thêm lịch khám</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Bệnh nhân</th>
            <th>Bác sĩ</th>
            <th>Ngày khám</th>
            <th>Giờ khám</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PatientName</td>
                <td>@item.Doctor?.DoctorName</td>
                <td>@item.AppointmentDate.ToString("dd/MM/yyyy")</td>
                <td>@item.AppointmentTime</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>