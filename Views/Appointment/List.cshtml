@model List<WebDatLichKham.Models.AppointmentModel>

<h2>DANH SÁCH LỊCH KHÁM</h2>

<p>
    <a href="/Appointment/Add">+ Thêm lịch khám</a>
</p>

<table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>Họ tên</th>
            <th>Chuyên khoa</th>
            <th>Điện thoại</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Specialty</td>
                <td>@item.Phone</td>
                <td>@item.TrangThai</td>
                <td>
                    <a href="/Appointment/Edit/@item.DoctorId">Sửa</a> |
                    <a href="/Appointment/Delete/@item.DoctorId">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
