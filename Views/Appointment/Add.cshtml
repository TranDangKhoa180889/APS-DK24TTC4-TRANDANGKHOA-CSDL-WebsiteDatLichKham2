@model WebDatLichKham.Models.Appointment

<h2>Thêm lịch hẹn</h2>

<form asp-action="Add" method="post">

    <!-- HIỂN THỊ LỖI -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label>Bệnh nhân</label>
        <input asp-for="PatientName" class="form-control" />
        <span asp-validation-for="PatientName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Ngày khám</label>
        <input asp-for="AppointmentDate"
               type="date"
               class="form-control"
               min="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>

    <div class="form-group">
        <label>Giờ khám</label>
        <input asp-for="AppointmentTime" class="form-control" />
        <span asp-validation-for="AppointmentTime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Bác sĩ</label>
        <select asp-for="DoctorId" class="form-control">
            <option value="">-- Chọn bác sĩ --</option>
            @foreach (var doctor in ViewBag.Doctors)
            {
                <option value="@doctor.Id">@doctor.DoctorName</option>
            }
        </select>
        <span asp-validation-for="DoctorId" class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-success">Lưu</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}